<?xml version="1.0"?>
<config>
    <sections>
        <google translate="label">
            <label>Google API</label>
            <tab>sales</tab>
            <frontend_type>text</frontend_type>
            <sort_order>1000</sort_order>
            <show_in_default>1</show_in_default>
            <show_in_website>1</show_in_website>
            <show_in_store>1</show_in_store>
            <groups>
                <measurement translate="label">
                    <label>GA4 Server-Side Events</label>
                    <frontend_type>text</frontend_type>
                    <sort_order>10</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <fields>
                        <enabled translate="label comment">
                            <label>Enable</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </enabled>
                        <transport translate="label comment">
                            <label>API Transport</label>
                            <frontend_type>select</frontend_type>
                            <source_model>gameasurementprotocol/system_config_source_transport</source_model>
                            <sort_order>15</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <depends>
                                <enabled>1</enabled>
                            </depends>
                            <comment><![CDATA[Measurement Protocol posts JSON with an API secret. Data Manager API ingests events via an OAuth service account (Google's strategic path for server-side integrations). Switching does not lose queued events — in-flight messages send via the transport configured at consume time.]]></comment>
                        </transport>
                        <measurement_id translate="label comment">
                            <label>Measurement ID</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <depends>
                                <enabled>1</enabled>
                            </depends>
                            <comment><![CDATA[Web data stream Measurement ID (G-XXXXXXX). Used by both transports — the Data Manager API ingests into the stream it identifies.]]></comment>
                        </measurement_id>
                        <api_secret translate="label comment">
                            <label>API Secret</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <depends>
                                <enabled>1</enabled>
                                <transport>measurement_protocol</transport>
                            </depends>
                            <comment><![CDATA[Measurement Protocol only. Created in GA Admin > Data Streams > Measurement Protocol API secrets.]]></comment>
                        </api_secret>
                        <dm_property_id translate="label comment">
                            <label>GA4 Property ID</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>32</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <depends>
                                <enabled>1</enabled>
                                <transport>data_manager</transport>
                            </depends>
                            <comment><![CDATA[Numeric GA4 property id (GA Admin > Property Settings), e.g. 213025502. Not the G-XXXXXXX measurement id.]]></comment>
                        </dm_property_id>
                        <dm_service_account_key translate="label comment">
                            <label>Service Account Key (JSON)</label>
                            <frontend_type>obscure</frontend_type>
                            <backend_model>gameasurementprotocol/system_config_backend_serviceAccountKey</backend_model>
                            <sort_order>34</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <depends>
                                <enabled>1</enabled>
                                <transport>data_manager</transport>
                            </depends>
                            <comment><![CDATA[Paste the full JSON key file of a Google Cloud service account that has the Data Manager API enabled in its project and is added as Editor on the GA4 property. Stored encrypted; shown obscured after save.]]></comment>
                        </dm_service_account_key>
                        <dm_validate translate="label comment">
                            <label>Validate Destination</label>
                            <frontend_model>gameasurementprotocol/adminhtml_system_config_validateDestination</frontend_model>
                            <sort_order>36</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <depends>
                                <enabled>1</enabled>
                                <transport>data_manager</transport>
                            </depends>
                            <comment>Sends a validate-only test event with the values on screen. Nothing is recorded in GA4.</comment>
                        </dm_validate>
                        <debug_mode translate="label">
                            <label>Debug Mode</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>40</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <depends>
                                <enabled>1</enabled>
                            </depends>
                            <comment><![CDATA[When enabled, debug_mode=true is sent only to visitors allowed by System > Developer > Developer Client Restrictions (dev/restrict/allow_ips). Important: this feature fails closed. If that list is empty, no visitor receives the debug flag and no debug requests are logged. See also: https://support.google.com/analytics/answer/7201382]]></comment>
                        </debug_mode>
                        <log_file translate="label comment">
                            <label>Log File</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>50</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                            <depends>
                                <debug_mode>1</debug_mode>
                            </depends>
                            <comment>Log file name inside var/log/ (e.g. ga_measurement.log).</comment>
                        </log_file>
                    </fields>
                </measurement>
            </groups>
        </google>
    </sections>
</config>
