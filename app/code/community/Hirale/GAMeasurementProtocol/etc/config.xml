<?xml version="1.0"?>
<config>
    <modules>
        <Hirale_GAMeasurementProtocol>
            <version>3.0.0</version>
        </Hirale_GAMeasurementProtocol>
    </modules>
    <default>
        <google>
            <measurement>
                <log_file>ga_measurement.log</log_file>
                <transport>measurement_protocol</transport>
            </measurement>
        </google>
    </default>
    <global>
        <helpers>
            <gameasurementprotocol>
                <class>Hirale_GAMeasurementProtocol_Helper</class>
            </gameasurementprotocol>
        </helpers>
        <models>
            <gameasurementprotocol>
                <class>Hirale_GAMeasurementProtocol_Model</class>
            </gameasurementprotocol>
        </models>
        <blocks>
            <gameasurementprotocol>
                <class>Hirale_GAMeasurementProtocol_Block</class>
            </gameasurementprotocol>
        </blocks>
        <resources>
            <gameasurementprotocol_setup>
                <setup>
                    <module>Hirale_GAMeasurementProtocol</module>
                </setup>
            </gameasurementprotocol_setup>
        </resources>
        <events>
            <sales_order_payment_refund>
                <observers>
                    <gameasurementprotocol_sales_order_payment_refund>
                        <type>singleton</type>
                        <class>gameasurementprotocol/observer</class>
                        <method>refund</method>
                    </gameasurementprotocol_sales_order_payment_refund>
                </observers>
            </sales_order_payment_refund>
        </events>
        <hirale_queue>
            <handlers>
                <Hirale_GAMeasurementProtocol_Message_MeasurementEventMessage>gameasurementprotocol/api</Hirale_GAMeasurementProtocol_Message_MeasurementEventMessage>
            </handlers>
            <routing>
                <Hirale_GAMeasurementProtocol_Message_MeasurementEventMessage>analytics</Hirale_GAMeasurementProtocol_Message_MeasurementEventMessage>
            </routing>
        </hirale_queue>
    </global>
    <adminhtml>
        <events>
            <controller_action_predispatch_adminhtml_system_config_save>
                <observers>
                    <gameasurementprotocol_validate_save>
                        <type>singleton</type>
                        <class>gameasurementprotocol/adminhtml_observer</class>
                        <method>validateConfigOnSave</method>
                    </gameasurementprotocol_validate_save>
                </observers>
            </controller_action_predispatch_adminhtml_system_config_save>
        </events>
    </adminhtml>
    <admin>
        <routers>
            <adminhtml>
                <args>
                    <modules>
                        <gameasurementprotocol before="Mage_Adminhtml">Hirale_GAMeasurementProtocol_Adminhtml</gameasurementprotocol>
                    </modules>
                </args>
            </adminhtml>
        </routers>
    </admin>
    <frontend>
        <events>
            <controller_front_send_response_after>
                <observers>
                    <gameasurementprotocol_controller_front_send_response_after>
                        <type>singleton</type>
                        <class>gameasurementprotocol/observer</class>
                        <method>generateClientId</method>
                    </gameasurementprotocol_controller_front_send_response_after>
                </observers>
            </controller_front_send_response_after>
            <sales_quote_item_save_after>
                <observers>
                    <gameasurementprotocol_sales_quote_item_save_after>
                        <type>singleton</type>
                        <class>gameasurementprotocol/observer</class>
                        <method>addOrRemoveItemsFromCart</method>
                    </gameasurementprotocol_sales_quote_item_save_after>
                </observers>
            </sales_quote_item_save_after>
            <sales_quote_item_delete_after>
                <observers>
                    <gameasurementprotocol_sales_quote_item_delete_after>
                        <class>gameasurementprotocol/observer</class>
                        <method>addOrRemoveItemsFromCart</method>
                    </gameasurementprotocol_sales_quote_item_delete_after>
                </observers>
            </sales_quote_item_delete_after>
            <wishlist_product_add_after>
                <observers>
                    <gameasurementprotocol_wishlist_product_add_after>
                        <type>singleton</type>
                        <class>gameasurementprotocol/observer</class>
                        <method>addToWishlist</method>
                    </gameasurementprotocol_wishlist_product_add_after>
                </observers>
            </wishlist_product_add_after>
            <customer_register_success>
                <observers>
                    <metaconversions_customer_register_success>
                        <type>singleton</type>
                        <class>gameasurementprotocol/observer</class>
                        <method>signUp</method>
                    </metaconversions_customer_register_success>
                </observers>
            </customer_register_success>
            <customer_login>
                <observers>
                    <metaconversions_customer_login>
                        <type>singleton</type>
                        <class>gameasurementprotocol/observer</class>
                        <method>login</method>
                    </metaconversions_customer_login>
                </observers>
            </customer_login>
            <sales_order_place_after>
                <observers>
                    <gameasurementprotocol_sales_order_place_after>
                        <type>singleton</type>
                        <class>gameasurementprotocol/observer</class>
                        <method>captureOrderClientId</method>
                    </gameasurementprotocol_sales_order_place_after>
                </observers>
            </sales_order_place_after>
            <core_app_run_after>
                <observers>
                    <gameasurementprotocol_core_app_run_after>
                        <type>singleton</type>
                        <class>Hirale_GAMeasurementProtocol_Model_Observer</class>
                        <method>dispatchRouteEvent</method>
                    </gameasurementprotocol_core_app_run_after>
                </observers>
            </core_app_run_after>
        </events>
    </frontend>
</config>