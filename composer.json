{
    "name": "hirale/openmage-ga4-measurement",
    "type": "maho-module",
    "license": "OSL-3.0",
    "description": "A module for integrating with the Google Analytics 4 Measurement Protocol API, built on hirale/queue.",
    "keywords": [
        "maho",
        "mahoecommerce",
        "magento1",
        "ga4",
        "analytics"
    ],
    "require": {
        "php": ">=8.3",
        "mahocommerce/maho": "^26.5",
        "hirale/queue": "^3.0 || dev-master",
        "jaybizzle/crawler-detect": "^1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "config": {
        "allow-plugins": {
            "mahocommerce/maho-composer-plugin": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HiraleGAMeasurementProtocol\\Tests\\": "tests/"
        }
    },
    "extra": {
        "maho-module-dir": "app/code/community/Hirale/GAMeasurementProtocol"
    },
    "scripts": {
        "test": "phpunit"
    },
    "authors": [
        { "name": "Hirale" }
    ]
}
